{
  "schema": "lean-proof-tree/profile/v1",
  "treeSpecification": "lean-expr/raw/v1",
  "input": {
    "sourceFile": "Diagonal.lean",
    "declaration": "Diagonal.cantor",
    "modules": []
  },
  "environment": {
    "toolchain": "leanprover/lean4:v4.35.0",
